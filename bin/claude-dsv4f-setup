#!/usr/bin/env bash
# claude-dsv4f-setup — one-time setup for Claude Code on DeepSeek V4 Flash 0731.
#
# Prompts for your DeepSeek API key with echo disabled, stores it 0600, calibrates the
# shim against the live endpoint, and installs the systemd --user service.
#
# The key is never echoed, never passed as an argument, never written to shell history,
# and never placed in Claude Code's environment.

set -euo pipefail

CONFIG_DIR="${DSV4F_CONFIG_DIR:-$HOME/.config/claude-dsv4f}"
DATA_DIR="${DSV4F_DATA_DIR:-$HOME/.local/share/claude-dsv4f}"
PROFILE_DIR="$HOME/.claude-dsv4f"
UNIT_DIR="$HOME/.config/systemd/user"

KEY_FILE="$CONFIG_DIR/key"
SENTINEL_FILE="$CONFIG_DIR/sentinel"
CONFIG_FILE="$CONFIG_DIR/config.json"

PROBE_ONLY=0
REKEY=0
for a in "$@"; do
  case "$a" in
    --probe) PROBE_ONLY=1 ;;
    --rekey) REKEY=1 ;;
    -h|--help)
      cat <<'EOF'
Usage: claude-dsv4f-setup [--rekey] [--probe]

  (no args)  full setup: key prompt, probe, install + start service
  --rekey    replace the stored API key, then re-probe and restart
  --probe    re-run the endpoint probe only (uses the existing key)
EOF
      exit 0 ;;
  esac
done

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$PROFILE_DIR" "$UNIT_DIR"
chmod 700 "$CONFIG_DIR"

[[ -f "$CONFIG_FILE" ]] || fail "Missing $CONFIG_FILE — reinstall claude-dsv4f."
command -v node >/dev/null || fail "node not found on PATH."

# ---------------------------------------------------------------- API key entry

if [[ $PROBE_ONLY -eq 0 ]]; then
  if [[ -s "$KEY_FILE" && $REKEY -eq 0 ]]; then
    bold "API key already stored at $KEY_FILE (use --rekey to replace)."
  else
    echo
    bold "DeepSeek API key"
    echo "Get one at https://platform.deepseek.com/api_keys"
    echo "Paste it at the prompt — input is hidden and not echoed."
    echo "Stored only in $KEY_FILE (mode 0600); never exported into Claude Code's environment."
    echo
    key=""
    # Prefer the controlling terminal so this still works when stdin is redirected
    # (e.g. run via the `!` prefix inside a Claude Code session).
    # Test by actually opening it: /dev/tty can exist yet be unopenable when there is no
    # controlling terminal (detached/sandboxed shells).
    if { : < /dev/tty; } 2>/dev/null; then
      printf 'DeepSeek API key: ' > /dev/tty
      IFS= read -rs key < /dev/tty
      printf '\n' > /dev/tty
    elif [[ -t 0 ]]; then
      printf 'DeepSeek API key: '
      IFS= read -rs key
      echo
    else
      fail "No terminal available for hidden input.
Run this directly in your terminal, or write the key to the file yourself:
  install -m600 /dev/null $KEY_FILE && printf '%s' 'sk-...' > $KEY_FILE && claude-dsv4f-setup --probe"
    fi
    key="${key//[$'\r\n\t ']/}"   # tolerate stray whitespace from a paste
    [[ -n "$key" ]] || fail "Empty key, aborted."
    if [[ "$key" != sk-* ]]; then
      warn "Warning: DeepSeek keys normally start with 'sk-'. Continuing anyway."
    fi
    umask 077
    printf '%s' "$key" > "$KEY_FILE"
    chmod 600 "$KEY_FILE"
    unset key
    bold "Stored."
  fi
fi

[[ -s "$KEY_FILE" ]] || fail "No API key stored. Run without --probe first."

# ------------------------------------------------------- local sentinel token

if [[ ! -s "$SENTINEL_FILE" ]]; then
  umask 077
  head -c 24 /dev/urandom | base64 | tr -d '/+=\n' > "$SENTINEL_FILE"
  chmod 600 "$SENTINEL_FILE"
fi
SENTINEL="$(cat "$SENTINEL_FILE")"

# ------------------------------------------------------------- key sanity check

echo
bold "Verifying key against DeepSeek..."
balfile="$(mktemp)"; trap 'rm -f "$balfile"' EXIT
# Key over stdin rather than argv, and a non-predictable temp path.
http_code="$(printf 'header = "Authorization: Bearer %s"\nurl = "https://api.deepseek.com/user/balance"\nsilent\noutput = "%s"\nwrite-out = "%%{http_code}"\nmax-time = 20\n' "$(cat "$KEY_FILE")" "$balfile" \
  | curl --config - || echo 000)"
if [[ "$http_code" != "200" ]]; then
  fail "Balance check failed (HTTP $http_code). Key rejected or network unreachable."
fi
if command -v jq >/dev/null; then
  jq -r '"  balance: \(.balance_infos[0].total_balance) \(.balance_infos[0].currency)  available=\(.is_available)"' "$balfile"
fi
# --------------------------------------------------------------------- probe

echo
bold "Probing endpoint behaviour (resolves the documentation contradictions)..."
node "$DATA_DIR/probe.mjs"

# ------------------------------------------------------------ profile settings

PORT="$(node -e 'process.stdout.write(String(process.env.DSV4F_PORT || JSON.parse(require("fs").readFileSync(process.argv[1],"utf8")).port || 8788))' "$CONFIG_FILE")"

cat > "$PROFILE_DIR/settings.json" <<EOF
{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:$PORT",
    "ANTHROPIC_AUTH_TOKEN": "$SENTINEL",

    "ANTHROPIC_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash-bg",
    "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-v4-flash-bg",
    "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash-sub",

    "ANTHROPIC_CUSTOM_MODEL_OPTION": "deepseek-v4-flash",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "DeepSeek V4 Flash 0731",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "DeepSeek V4 Flash 0731 via local claude-dsv4f shim",

    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK": "1",

    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "384000",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "600000",
    "API_TIMEOUT_MS": "900000",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "900000"
  },
  "effortLevel": "high",
  "skipWebFetchPreflight": true,
  "statusLine": {
    "type": "command",
    "command": "$DATA_DIR/statusline.sh",
    "refreshInterval": 10
  },
  "permissions": {
    "defaultMode": "auto"
  }
}
EOF
chmod 600 "$PROFILE_DIR/settings.json"   # embeds the sentinel; the umask 077 calls above
                                         # only run on the new-key / new-sentinel paths
bold "Wrote $PROFILE_DIR/settings.json (mode 0600)"

# ------------------------------------------------------------- systemd service

cat > "$UNIT_DIR/claude-dsv4f-shim.service" <<EOF
[Unit]
Description=claude-dsv4f shim (Claude Code -> DeepSeek V4 Flash)
After=network-online.target

[Service]
Type=simple
ExecStart=$(command -v node) $DATA_DIR/shim.mjs
Restart=on-failure
RestartSec=2
Environment=NODE_ENV=production
# The key is read from disk by the shim; it is deliberately not in the unit environment.

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
systemctl --user enable claude-dsv4f-shim.service >/dev/null 2>&1 || true
systemctl --user restart claude-dsv4f-shim.service

sleep 1
if systemctl --user is-active --quiet claude-dsv4f-shim.service; then
  bold "Service running."
else
  warn "Service failed to start. Check: journalctl --user -u claude-dsv4f-shim -n 50"
  exit 1
fi

health="$(curl -s "http://127.0.0.1:$PORT/_dsv4f/health" || true)"
echo "  health: ${health:-no response}"

cat <<EOF

$(bold "Setup complete.")

  Launch          : claude-dsv4f
  Ultracode       : claude-dsv4f --effort ultracode    (or /effort ultracode in-session)
  Spend + tokens  : dsv4f-usage
  Daily cap       : dsv4f-cap            (show)   dsv4f-cap 10   (set \$10)
  Logs            : journalctl --user -u claude-dsv4f-shim -f

Your normal 'claude' is untouched and still uses your Anthropic subscription.
EOF
