#!/usr/bin/env node
/** MMClaude usage monitor: local token ledger plus live MiniMax Token Plan quota. */
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import http from 'node:http';

const HOME = os.homedir();
const CONFIG_DIR = process.env.MMCLAUDE_CONFIG_DIR || path.join(HOME, '.config', 'mmclaude');
const DATA_DIR = process.env.MMCLAUDE_DATA_DIR || path.join(HOME, '.local', 'share', 'mmclaude');
const LEDGER = path.join(DATA_DIR, 'usage.jsonl');
const cfg = JSON.parse(fs.readFileSync(path.join(CONFIG_DIR, 'config.json'), 'utf8'));
const args = process.argv.slice(2);
const days = parseInt(args.includes('--days') ? args[args.indexOf('--days') + 1] : '1', 10);
const bold = s => `\x1b[1m${s}\x1b[0m`;
const dim = s => `\x1b[2m${s}\x1b[0m`;
const num = n => Number(n || 0).toLocaleString('en-US');
const readJsonl = f => { try { return fs.readFileSync(f, 'utf8').split('\n').filter(x => x.startsWith('{')).map(x => JSON.parse(x)); } catch { return []; } };
const rows = readJsonl(LEDGER).filter(r => Date.parse(r.ts) >= Date.now() - days * 86400000);

if (args.includes('--json')) { console.log(JSON.stringify(rows, null, 2)); process.exit(0); }

const input = rows.reduce((s, r) => s + (r.inputTokens || 0), 0);
const output = rows.reduce((s, r) => s + (r.outputTokens || 0), 0);
console.log(bold(`\nmmclaude usage — last ${days} day${days === 1 ? '' : 's'}\n`));
console.log(`  requests       : ${num(rows.length)}`);
console.log(`  accounting     : MiniMax Token Plan quota (provider percentages; no invented token or dollar cost)`);

const by = key => {
  const m = new Map();
  for (const r of rows) { const k = r[key] || '?'; const v = m.get(k) || { n: 0, in: 0, out: 0 }; v.n++; v.in += r.inputTokens || 0; v.out += r.outputTokens || 0; m.set(k, v); }
  return [...m.entries()].sort((a, b) => b[1].in + b[1].out - a[1].in - a[1].out);
};
if (rows.length) {
  console.log(bold('\n  by slot'));
  for (const [k, v] of by('slot')) console.log(`    ${String(k).padEnd(12)} ${String(v.n).padStart(5)} requests`);
  console.log(bold('\n  by thinking mode'));
  for (const [k, v] of by('effort')) console.log(`    ${String(k).padEnd(12)} ${String(v.n).padStart(5)} requests`);
}

let sentinel = '';
try { sentinel = fs.readFileSync(path.join(CONFIG_DIR, 'sentinel'), 'utf8').trim(); } catch {}
const port = cfg.port || 8788;
http.get({ host: '127.0.0.1', port, path: '/_mmclaude/usage', timeout: 2000, headers: { authorization: `Bearer ${sentinel}` } }, res => {
  let b = ''; res.on('data', d => b += d); res.on('end', () => {
    try {
      const s = JSON.parse(b);
      const rawRows = Array.isArray(s.balance?.model_remains) ? s.balance.model_remains : [];
      const rawRow = rawRows.find(r => String(r?.model_name || '').toLowerCase() === 'general') || rawRows[0] || {};
      const rawPct = v => Number.isFinite(Number(v)) ? Number(v) : null;
      const liveQuota = {
        ...(s.quota || {}),
        enabled: s.quota?.enabled ?? rawRows.length > 0,
        remainingPercent: s.quota?.remainingPercent ?? rawPct(rawRow.current_interval_remaining_percent),
        weeklyRemainingPercent: s.quota?.weeklyRemainingPercent ?? rawPct(rawRow.current_weekly_remaining_percent),
      };
      console.log(bold('\n  live'));
      console.log(`    local requests : ${num(s.requests || 0)} (diagnostic ledger)`);
      if (s.traffic) console.log(`    traffic        : ${s.traffic.active}/${s.traffic.maxConcurrent} active, ${s.traffic.queued} queued (${s.traffic.maxBackgroundConcurrent} background lane)`);
      if (liveQuota.enabled) {
        const p = v => v == null ? 'unknown' : `${Number(v).toFixed(0)}% remaining`;
        console.log(`    quota 5h       : ${p(liveQuota.remainingPercent)}${liveQuota.paused ? ` — PAUSED until ${liveQuota.resumeAt || 'provider refresh'}` : ''}`);
        console.log(`    quota weekly   : ${p(liveQuota.weeklyRemainingPercent)}`);
      }
      const q = s.balance;
      if (q) {
        console.log(`    quota polled   : ${q._polledAt || 'unknown'}`);
      } else console.log('    token plan     : no live quota snapshot yet');
      console.log('');
    } catch { console.log(dim('\n  (shim returned no live usage yet)\n')); }
  });
}).on('error', () => console.log(dim('\n  (shim not running — live quota unavailable)\n')));
